<Window x:Class="filatov_pz3.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:filatov_pz3"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800"
        Icon="/a9c4732403c35262303d13bf74c6ec0e.868x1000x1.jpg">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="#FF76E383">
            <Image Width="45" Height="45"
                   HorizontalAlignment="Left"
                   Margin="5"
                   Source="/a9c4732403c35262303d13bf74c6ec0e.868x1000x1.jpg"/>
            <Button x:Name="btnBack"
                    Content="Назад"
                    HorizontalAlignment="Right"
                    Click="btnBack_Click"/>
        </Grid>

        <Frame x:Name="FrmMain"
               Grid.Row="1"
               NavigationUIVisibility="Hidden"
               ContentRendered="FrmMain_ContentRendered"/>
    </Grid>
</Window>